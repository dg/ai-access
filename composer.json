{
	"name": "ai-access/ai-access",
	"description": "?? AI Access: one clean PHP interface for OpenAI, Claude, Gemini, DeepSeek and Grok, with chat, embeddings and batch processing. Switch providers with one line; no vendor SDKs, no dependencies.",
	"keywords": ["ai", "llm", "openai", "chatgpt", "claude", "anthropic", "gemini", "deepseek", "grok", "embeddings", "api client", "sdk"],
	"homepage": "https://ai-access.deegee.dev",
	"license": ["BSD-3-Clause"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-curl": "*",
		"ext-fileinfo": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"nette/schema": "^1.4",
		"tracy/tracy": "^2.10",
		"phpstan/phpstan": "^2.2@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0",
		"mockery/mockery": "^1.6",
		"dg/bypass-finals": "^1.9"
	},
	"suggest": {
		"nette/schema": "to write response and tool schemas with Expect and get the answer validated and cast"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"minimum-stability": "stable",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
