# Copy to .env and fill in the keys of the providers you want to run.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://console.x.ai/team/default/api-keys
XAI_API_KEY=
# Optional, used by examples/providers/openrouter.php
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: default provider when none is passed on the command line
#AI_PROVIDER=openai
# Optional: override the chat model picked by bootstrap.php
#AI_MODEL=
